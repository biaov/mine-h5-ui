{
  "name": "mine-h5-ui",
  "version": "2.17.3",
  "private": false,
  "author": {
    "name": "biaov",
    "email": "biaov@qq.com",
    "url": "https://biaov.cn/"
  },
  "main": "es/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "style": "styles/index.css",
  "description": "一款轻量级、模块化基于 Vue3.x 的 H5 前端 UI 组件库 👍",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite -m development",
    "build": "npm run build:docs && npm run build:theme && npm run build:theme:rem && npm run build:package",
    "build:docs": "vite build",
    "build:theme": "vite build --config scripts/theme.vite.ts",
    "build:theme:rem": "set rem=1 && vite build --config scripts/theme.vite.ts",
    "build:package": "vite build --config scripts/package.vite.ts",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:single": "vitest dev tests/unit/collapse.spec.ts",
    "test:ui": "vite-node ./tests/ui/index.ts",
    "prepare": "husky",
    "pre-publish": "node scripts/pre-publish.ts",
    "pre-publish:github": "set NODE_PRE=github && node scripts/pre-publish.ts && start cmd /k cd ./dist/packages",
    "lint": "eslint --fix ./**",
    "prettier": "prettier --write '**/*.{ts,js,less,md,json,vue,cjs}'",
    "tag": "node scripts/tag.ts"
  },
  "types": "es/index.d.ts",
  "engines": {
    "node": ">=24.3"
  },
  "keywords": [
    "组件库",
    "typescript",
    "vue",
    "ui组件",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/biaov/mine-h5-ui.git"
  },
  "homepage": "https://mineh5ui.biaov.cn/v2",
  "bugs": {
    "url": "https://github.com/biaov/mine-h5-ui/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "engine-strict": true,
    "provenance": true
  },
  "license": "ISC",
  "contributors": [
    {
      "name": "biaov",
      "email": "biaov@qq.com"
    }
  ],
  "dependencies": {
    "clipboard": "^2.0.11",
    "html2canvas": "^1.4.1",
    "mockjs": "^1.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it-container": "^4.0.0",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.1.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "markdown-it-container": "^4.0.0",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.6",
    "selenium-webdriver": "^4.46.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "unplugin-vue-markdown": "^32.0.0",
    "vi-canvas-mock": "^1.0.0",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-eslint2": "^5.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.3"
  }
}