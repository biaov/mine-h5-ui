{
  "name": "mine-h5-ui",
  "version": "2.19.0",
  "private": false,
  "author": {
    "name": "biaov",
    "email": "biaov@qq.com",
    "url": "https://biaov.cn/"
  },
  "main": "es/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "style": "styles/index.css",
  "description": "一款轻量级、模块化基于 Vue3.x 的 H5 前端 UI 组件库 👍",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite -m development",
    "build": "npm run build:docs && npm run build:theme && npm run build:theme:vw && npm run build:package",
    "build:docs": "vite build",
    "build:theme": "vite build --config scripts/theme.vite.ts",
    "build:theme:vw": "vite build --config scripts/theme.vite.ts --mode vw",
    "build:package": "vite build --config scripts/package.vite.ts",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:single": "vitest dev tests/unit/collapse.spec.ts",
    "test:ui": "vite-node ./tests/ui/index.ts",
    "prepare": "husky",
    "pre-publish": "node scripts/pre-publish.ts",
    "pre-publish:github": "set NODE_PRE=github && node scripts/pre-publish.ts && start cmd /k cd ./dist/packages",
    "lint": "eslint --fix ./**",
    "prettier": "prettier --write '**/*.{ts,js,less,md,json,vue,cjs}'",
    "tag": "node scripts/tag.ts",
    "mcp:extract": "npm --prefix mcp run extract",
    "mcp:check": "npm --prefix mcp run check",
    "mcp:build": "npm --prefix mcp run build",
    "tsc": "tsc --noEmit --watch"
  },
  "types": "es/index.d.ts",
  "engines": {
    "node": ">=24.3"
  },
  "keywords": [
    "组件库",
    "typescript",
    "vue",
    "ui组件",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/biaov/mine-h5-ui.git"
  },
  "homepage": "https://mineh5ui.biaov.cn/v2",
  "bugs": {
    "url": "https://github.com/biaov/mine-h5-ui/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "engine-strict": true,
    "provenance": true
  },
  "license": "ISC",
  "contributors": [
    {
      "name": "biaov",
      "email": "biaov@qq.com"
    }
  ],
  "dependencies": {
    "clipboard": "^2.0.11",
    "html2canvas": "^1.4.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "markdown-it-container": "^4.0.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.52.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-vue-markdown": "^32.1.1",
    "vi-canvas-mock": "^1.0.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-eslint2": "^5.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.67.4"
  }
}
